# Breezedoc SDK Configuration
# Copy this file to .env and fill in your credentials

# Personal Access Token from https://breezedoc.com/integrations/api
BREEZEDOC_API_TOKEN=your-api-token-here

# Email address used for integration tests (must be an address you control)
BREEZEDOC_TEST_EMAIL=your-test-email@example.com

# Web login credentials, used only by the login-based PDF download feature.
# These are your breezedoc.com website email + password (NOT the API token).
# Required only if you use downloadPdf(); leave blank otherwise.
BREEZEDOC_WEB_EMAIL=your-login-email@example.com
BREEZEDOC_WEB_PASSWORD=your-login-password
